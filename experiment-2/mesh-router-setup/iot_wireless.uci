config wifi-iface 'iot'
	option device 'radio0'
	option network 'wlaniot'
	option mode 'ap'
	option ssid 'iot-lan'
	option encryption 'psk2'
	option vlan_file '/srv/micro-segmentation/experiment-2/mesh-router-setup/wpa_keys/hostapd.vlan'
	option wpa_psk_file '/srv/micro-segmentation/experiment-2/mesh-router-setup/wpa_keys/hostapd.wpa_psk'